                  "quoting"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "description": "%cppbuild.args.value.description%"
                  },
                  "quoting": {
                    "type": "string",
                    "enum": [
                      "escape",
                      "strong",
                      "weak"
                    ],
                    "enumDescriptions": [
                      "%cppbuild.args.quoting.escape.description%",
                      "%cppbuild.args.quoting.strong.description%",
                      "%cppbuild.args.quoting.weak.description%"
